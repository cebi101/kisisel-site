# Cloudflare Pages başlıkları
# NOT: Aynı başlık birden çok kuralda geçerse SONRAKİ kural kazanır.
# Bu yüzden genel kural önce, varlık kuralları sonra yazılır.

# Tüm sayfalar: her ziyarette tazeliği doğrula.
# (HTML önbelleğe alınırsa site güncellenince kullanıcı eski sürümü görür.)
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  ! Access-Control-Allow-Origin

# Adında içerik özeti taşıyan dosyalar hiç değişmez → kalıcı önbellek
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Paylaşım kartı ve ikon: bir gün önbellek yeterli
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-*.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
