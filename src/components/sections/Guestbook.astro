---
import { PAGE_NUM } from "../../data/routes";
// Ziyaretçi defteri — notlar /api/guestbook üzerinden tarayıcıda yüklenir.
// Sunucu tarafı statik kalır; yalnızca API çağrıları dinamiktir.
import type { Dict } from "../../i18n/translations";

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const g = t.guestbook;
---

<div class="page">
  <div class="page-head">
    <span class="page-no" aria-hidden="true">{PAGE_NUM.guestbook}</span>
    <h1 class="section-title">{g.title}</h1>
  </div>

  <div class="gb-grid">
    <form
      class="gb-form reveal"
      id="gb-form"
      data-strings={JSON.stringify({
        pending: g.pending,
        short: g.errorShort,
        rate: g.errorRate,
        generic: g.errorGeneric,
        emptyTitle: g.emptyTitle,
        emptySub: g.emptySub,
        emptyCta: g.emptyCta,
        errorTitle: g.errorTitle,
        errorSub: g.errorSub,
        retry: g.retry,
      })}
    >
      <p class="contact-sub">{g.sub}</p>

      <label for="gb-name" class="visually-hidden">{g.fName}</label>
      <input
        type="text"
        id="gb-name"
        name="name"
        maxlength="40"
        autocomplete="name"
        placeholder={g.fName}
        required
      />

      <label for="gb-msg" class="visually-hidden">{g.fMsg}</label>
      <textarea id="gb-msg" name="message" rows="4" maxlength="280" placeholder={g.fMsg} required
      ></textarea>

      {/* bal küpü: ekranda görünmez, yalnızca botlar doldurur */}
      <div class="gb-hp" aria-hidden="true">
        <label for="gb-website">Website</label>
        <input type="text" id="gb-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-solid">
        {g.fSend}
        <span class="arr" aria-hidden="true">→</span>
      </button>
      <p class="gb-status" id="gb-status" role="status" aria-live="polite"></p>
      <p class="form-hint gb-privacy">{g.privacy}</p>
    </form>

    <div class="gb-list reveal d1" id="gb-list" data-empty={g.empty} data-loading={g.loading}>
      <p class="gb-muted">{g.loading}</p>
    </div>
  </div>
</div>

<style>
  .gb-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }
  .gb-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .gb-form input,
  .gb-form textarea {
    font-family: var(--font-sans);
    font-size: 16px;
    padding: 14px 15px;
    border: 1px solid var(--faint2);
    background: var(--field);
    color: var(--body);
    border-radius: 10px;
    width: 100%;
    resize: vertical;
  }
  .gb-form input:focus,
  .gb-form textarea:focus {
    border-color: var(--accent);
  }
  .gb-form .btn {
    align-self: flex-start;
  }
  .gb-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .gb-status {
    font-size: 14px;
    color: var(--accent2);
    min-height: 1.2em;
  }
  .gb-status[data-error] {
    color: var(--accent-d);
  }
  .gb-privacy {
    line-height: 1.5;
  }
  .gb-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 940px) {
    .gb-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  @keyframes gb-shimmer {
    to {
      background-position: -150% 0;
    }
  }
</style>

<script>
  import type { GuestbookEntry, GuestbookStrings } from "../../types/api";

  const initGuestbook = () => {
    const form = document.getElementById("gb-form") as HTMLFormElement | null;
    const list = document.getElementById("gb-list");
    const statusEl = document.getElementById("gb-status");
    if (!form || !list) return;
    if (form.dataset.bound) return; // çift dinleyici → çift gönderim olmasın
    form.dataset.bound = "1";

    const strings: GuestbookStrings = JSON.parse(form.dataset.strings || "{}");
    const locale = document.documentElement.lang === "en" ? "en-GB" : "tr-TR";

    const render = (entries: GuestbookEntry[]) => {
      list.textContent = "";
      if (!entries.length) {
        list.append(bosDurum());
        return;
      }
      for (const e of entries) {
        const card = document.createElement("div");
        card.className = "gb-entry";
        const top = document.createElement("div");
        top.className = "gb-entry-top";
        const name = document.createElement("span");
        name.className = "gb-name";
        name.textContent = e.name; // textContent → HTML enjeksiyonu imkânsız
        const date = document.createElement("span");
        date.className = "gb-date";
        date.textContent = new Date(e.created_at).toLocaleDateString(locale, {
          day: "2-digit",
          month: "short",
          year: "numeric",
        });
        top.append(name, date);
        const msg = document.createElement("p");
        msg.className = "gb-msg";
        msg.textContent = e.message;
        card.append(top, msg);
        list.append(card);
      }
    };

    /** Boş durum: ortalanmış blok + forma odaklayan düğme. */
    const bosDurum = () => {
      const kutu = document.createElement("div");
      kutu.className = "gb-empty";
      const ikon = document.createElement("span");
      ikon.className = "gb-empty-icon";
      ikon.setAttribute("aria-hidden", "true");
      ikon.textContent = "✎";
      const bas = document.createElement("p");
      bas.className = "gb-empty-title";
      bas.textContent = strings.emptyTitle ?? "";
      const alt = document.createElement("p");
      alt.className = "gb-empty-sub";
      alt.textContent = strings.emptySub ?? "";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "gb-action";
      btn.textContent = strings.emptyCta ?? "";
      btn.addEventListener("click", () => {
        (form.querySelector("input[name=name]") as HTMLInputElement | null)?.focus();
      });
      kutu.append(ikon, bas, alt, btn);
      return kutu;
    };

    /** Yükleniyor: gerçek kart yüksekliğinde iskelet — düzen sıçramaz. */
    const iskelet = () => {
      const sar = document.createElement("div");
      sar.setAttribute("aria-hidden", "true");
      for (let i = 0; i < 3; i++) {
        const s = document.createElement("div");
        s.className = "gb-skeleton";
        sar.append(s);
      }
      return sar;
    };

    /** Hata: sebebini söyler ve YENİDEN DENEME sunar. */
    const hataDurumu = () => {
      list.textContent = "";
      const kutu = document.createElement("div");
      kutu.className = "gb-error";
      kutu.setAttribute("role", "alert");
      const bas = document.createElement("p");
      bas.className = "gb-error-title";
      bas.textContent = strings.errorTitle ?? strings.generic;
      const alt = document.createElement("p");
      alt.className = "gb-error-sub";
      alt.textContent = strings.errorSub ?? "";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "gb-action";
      btn.textContent = strings.retry ?? "";
      btn.addEventListener("click", () => yukle());
      kutu.append(bas, alt, btn);
      list.append(kutu);
    };

    const yukle = () => {
      list.textContent = "";
      list.append(iskelet());
      fetch("/api/guestbook")
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d) => (d.unavailable ? hataDurumu() : render(d.entries || [])))
        .catch(hataDurumu);
    };

    yukle();

    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (!statusEl) return;
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
      if (btn?.disabled) return; // uçuşta istek varken ikinci gönderim yok
      if (btn) btn.disabled = true;
      statusEl.removeAttribute("data-error");
      const fd = new FormData(form);
      const payload = {
        name: String(fd.get("name") || ""),
        message: String(fd.get("message") || ""),
        website: String(fd.get("website") || ""),
      };
      try {
        const res = await fetch("/api/guestbook", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          statusEl.textContent = strings.pending;
          form.reset();
        } else {
          statusEl.setAttribute("data-error", "");
          statusEl.textContent =
            data.error === "too_short"
              ? strings.short
              : data.error === "rate_limited"
                ? strings.rate
                : strings.generic;
        }
      } catch {
        statusEl.setAttribute("data-error", "");
        statusEl.textContent = strings.generic;
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  };

  // ClientRouter astro:page-load'ı ilk yüklemede de tetikler
  document.addEventListener("astro:page-load", initGuestbook);
</script>
