---
import { PAGE_NUM } from "../../data/routes";
import type { Dict } from "../../i18n/translations";
import { PROJECTS } from "../../data/site";

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<div class="page">
  <div class="page-head">
    <span class="page-no" aria-hidden="true">{PAGE_NUM.projects}</span>
    <h1 class="section-title">{t.projects.title}</h1>
  </div>
  <div class="project-list">
    {
      t.projects.items.map((p, i) => {
        const meta = PROJECTS[i];
        const href = meta?.href ?? null;
        const state = meta?.state ?? "public";
        const Tag = href ? "a" : "div";
        return (
          <Tag
            href={href ?? undefined}
            target={href ? "_blank" : undefined}
            rel={href ? "noopener" : undefined}
            class={`project-row reveal ${href ? "" : "no-link"} ${i ? `d${Math.min(i, 3)}` : ""}`}
          >
            <span class="pr-num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="pr-body">
              <h2 class="pr-title">{p.title}</h2>
              <span class="pr-desc">{p.desc}</span>
              <span class="pr-tags">{p.tags}</span>
            </span>
            {href ? (
              <span class="pr-arrow" aria-hidden="true">
                ↗
              </span>
            ) : (
              <span class="pr-state">
                <span class="pr-state-dot" aria-hidden="true" />
                {t.projects.stateLabels[state as "private" | "wip"]}
              </span>
            )}
          </Tag>
        );
      })
    }
  </div>
</div>
