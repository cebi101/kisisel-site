---
// Portfolyo.dc tasarımından uyarlanan arayüz — nokta desenli zemin
// Sol kenar: profil kartı · numaralı menü · ŞU AN kartı · tema & dil
// Sayfalar (sekme): Ana Sayfa · Hakkımda · Projeler · İletişim
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import type { Dict } from "../i18n/translations";
import { SKILL_GROUPS } from "../i18n/translations";
import foto from "../assets/foto.jpg";

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const GITHUB = "https://github.com/cebi101";
const LINKEDIN = "https://www.linkedin.com/in/seymanurcebi";
const EMAIL = "seymanurcebi6@gmail.com";

const langs = [
  { code: "TR", href: "/", lang: "tr", name: "Türkçe" },
  { code: "EN", href: "/en/", lang: "en", name: "English" },
  { code: "DE", href: "/de/", lang: "de", name: "Deutsch" },
  { code: "RU", href: "/ru/", lang: "ru", name: "Русский" },
  { code: "AR", href: "/ar/", lang: "ar", name: "العربية" },
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Şeyma Nur Çebi",
  jobTitle: t.title.split("—")[1]?.trim(),
  email: `mailto:${EMAIL}`,
  sameAs: [GITHUB, LINKEDIN],
};

const navItems = [
  { id: "home", num: "01", label: t.nav.home },
  { id: "about", num: "02", label: t.nav.about },
  { id: "projects", num: "03", label: t.nav.projects },
  { id: "contact", num: "04", label: t.nav.contact },
];

const sideSocials = [
  { short: "GH", label: "GitHub", href: GITHUB },
  { short: "IN", label: "LinkedIn", href: LINKEDIN },
  { short: "@", label: t.emailLabel, href: `mailto:${EMAIL}` },
];

// sıra: VARIANT-GNN · Dil Ajanları · Biyobelirteç · YemekStes
// null = herkese açık repo yok (VARIANT-GNN & Biyobelirteç private/repo yok),
// tıklanamaz kart olarak render edilir — kırık link / 404 olmasın
const projectHrefs: (string | null)[] = [
  null,
  "https://github.com/msgxr/teknofest-2026-kamu-evrak-akilli-ajan",
  null,
  "https://github.com/cebi101/YemekStes",
];
---

<Layout title={t.title} description={t.description} lang={t.lang} dir={t.dir}>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
  <a class="skip-link" href="#icerik">{t.skipLink}</a>
  <div class="app">
    <!-- ════════ KENAR ÇUBUĞU ════════ -->
    <aside class="sidebar">
      <div class="profile-card">
        <div class="avatar-wrap">
          <Image src={foto} width={152} alt={t.hero.photoAlt} class="avatar" loading="eager" />
          <span class="status-dot" aria-hidden="true"></span>
        </div>
        <div class="profile-name">{t.name}</div>
        <div class="profile-role">{t.role}</div>
      </div>

      <nav class="nav-links">
        {navItems.map((n) => (
          <a href={`#${n.id}`} class="nav-btn" aria-current={n.id === "home" ? "page" : undefined}>
            <span class="num" aria-hidden="true">{n.num}</span>
            <span class="lbl">{n.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </nav>

      <div class="side-bottom">
        <div class="now-card">
          <div class="now-head">
            <span class="now-dot" aria-hidden="true"></span>
            <span class="now-label">{t.now.label}</span>
          </div>
          {t.now.items.map((it) => (
            <div class="now-item">
              <span class="now-k">{it.k}</span>
              <span class="now-v">{it.v}</span>
            </div>
          ))}
        </div>

        <div class="social-row">
          {sideSocials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener" : undefined}
              title={s.label}
              aria-label={s.label}
            >{s.short}</a>
          ))}
        </div>

        <div class="side-label">{t.themeLabel}</div>
        <div class="mode-switch">
          <button data-mode="light" title={t.modeLight} aria-label={t.modeLight}>☀</button>
          <button data-mode="dark" title={t.modeDark} aria-label={t.modeDark}>☾</button>
        </div>

        <div class="side-label">{t.langLabel}</div>
        <div class="lang-switch">
          {langs.map((l) => (
            <a
              href={l.href}
              hreflang={l.lang}
              lang={l.lang}
              aria-label={l.name}
              aria-current={t.path === l.href ? "true" : undefined}
              class={t.path === l.href ? "on" : ""}
            >{l.code}</a>
          ))}
        </div>
      </div>
    </aside>

    <!-- ════════ İÇERİK ════════ -->
    <main class="content" id="icerik" tabindex="-1">
      <!-- ── 01 ANA SAYFA ── -->
      <div class="tab-panel active" id="home">
        <div class="page home">
          <div class="hero-left">
            <div class="hero-head">
              <div class="hello">{t.hero.hello}</div>
              <h1>
                {t.hero.h1a}<br />
                <em>{t.hero.h1b}</em>
              </h1>
            </div>
            <p class="tagline">{t.hero.tagline}</p>
            <div class="cta-row">
              <a href="#projects" class="btn btn-solid">{t.hero.cta} <span class="arr" aria-hidden="true">→</span></a>
              <a href="#contact" class="btn btn-line">{t.nav.contact}</a>
            </div>
          </div>
          <div class="hero-photo reveal">
            <div class="photo-backdrop" aria-hidden="true"></div>
            <Image src={foto} width={680} alt={t.hero.photoAlt} class="photo" loading="eager" fetchpriority="high" />
            <div class="photo-badge">{t.role}</div>
          </div>
        </div>
      </div>

      <!-- ── 02 HAKKIMDA ── -->
      <div class="tab-panel" id="about">
        <div class="page">
          <div class="page-head">
            <span class="page-no">{t.about.no}</span>
            <h2 class="section-title">{t.about.title}</h2>
          </div>

          <div class="about-grid">
            <div class="about-photo reveal">
              <Image src={foto} width={600} alt={t.hero.photoAlt} />
              <div class="photo-badge">{t.about.year}</div>
            </div>
            <div class="about-body reveal d1">
              <p class="about-p1">{t.about.p1}</p>
              <p class="about-p2">{t.about.p2}</p>
              <div class="side-label">{t.about.skillsLabel}</div>
              {SKILL_GROUPS.map((g) => (
                <div class="skill-group">
                  <span class="skill-group-label">{t.about.skillGroups[g.key]}</span>
                  <div class="chips">
                    {g.items.map((sk) => <span class="chip">{sk}</span>)}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <h3 class="side-label block-label reveal">{t.about.eduLabel}</h3>
          <div class="timeline">
            {t.about.edu.map((j) => (
              <div class="tl-item reveal">
                <div class="tl-when">{j.when}</div>
                <h4>{j.title}</h4>
                <p>{j.desc}</p>
                <span class="tl-badge">{j.badge}</span>
              </div>
            ))}
          </div>

          <h3 class="side-label block-label reveal">{t.about.expLabel}</h3>
          <div class="timeline">
            {t.about.exp.map((j, i) => (
              <div class={`tl-item reveal ${i ? `d${Math.min(i, 3)}` : ""}`}>
                <div class="tl-when">{j.when}</div>
                <h4>{j.title}</h4>
                <p>{j.desc}</p>
              </div>
            ))}
          </div>

          <h3 class="side-label block-label reveal">{t.about.compLabel}</h3>
          <div class="timeline">
            {t.about.comp.map((j, i) => (
              <div class={`tl-item reveal ${i ? `d${Math.min(i, 3)}` : ""}`}>
                <div class="tl-when">{j.when}</div>
                <h4>{j.title}</h4>
                <p>{j.desc}</p>
              </div>
            ))}
          </div>

          <h3 class="side-label block-label reveal">{t.about.certsLabel}</h3>
          <div class="cert-grid">
            {t.about.certs.map((c, i) => (
              <div class={`cert-card reveal ${i ? "d1" : ""}`}>
                <span class="cert-org">{c.org}</span>
                <h4>{c.name}</h4>
                <p>{c.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- ── 03 PROJELER ── -->
      <div class="tab-panel" id="projects">
        <div class="page">
          <div class="page-head">
            <span class="page-no">{t.projects.no}</span>
            <h2 class="section-title">{t.projects.title}</h2>
          </div>
          <div class="project-list">
            {t.projects.items.map((p, i) => {
              const href = projectHrefs[i];
              const Tag = href ? "a" : "div";
              return (
                <Tag
                  href={href ?? undefined}
                  target={href ? "_blank" : undefined}
                  rel={href ? "noopener" : undefined}
                  class={`project-row reveal ${href ? "" : "no-link"} ${i ? `d${Math.min(i, 3)}` : ""}`}
                >
                  <span class="pr-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <span class="pr-body">
                    <span class="pr-title">{p.title}</span>
                    <span class="pr-desc">{p.desc}</span>
                    <span class="pr-tags">{p.tags}</span>
                  </span>
                  {href && <span class="pr-arrow" aria-hidden="true">↗</span>}
                </Tag>
              );
            })}
          </div>
        </div>
      </div>

      <!-- ── 04 İLETİŞİM ── -->
      <div class="tab-panel" id="contact">
        <div class="page">
          <div class="page-head">
            <span class="page-no">{t.contact.no}</span>
            <h2 class="section-title">{t.contact.title}</h2>
          </div>
          <div class="contact-grid">
            <form class="contact-form reveal" id="contact-form" data-email={EMAIL} data-subject={t.contact.fSubject}>
              <p class="contact-sub">{t.contact.sub}</p>
              <label for="f-name" class="visually-hidden">{t.contact.fName}</label>
              <input type="text" id="f-name" name="name" autocomplete="name" placeholder={t.contact.fName} required />
              <label for="f-email" class="visually-hidden">{t.contact.fEmail}</label>
              <input type="email" id="f-email" name="email" autocomplete="email" placeholder={t.contact.fEmail} required />
              <label for="f-msg" class="visually-hidden">{t.contact.fMsg}</label>
              <textarea id="f-msg" name="msg" rows="5" placeholder={t.contact.fMsg} required></textarea>
              <button type="submit" class="btn btn-solid">{t.contact.fSend} <span class="arr" aria-hidden="true">→</span></button>
              <span class="form-hint">{t.contact.fHint}</span>
            </form>
            <div class="contact-side reveal d1">
              <div class="side-label">{t.contact.social}</div>
              <a href={GITHUB} target="_blank" rel="noopener" class="social-link"><span>GitHub</span><span aria-hidden="true">↗</span></a>
              <a href={LINKEDIN} target="_blank" rel="noopener" class="social-link"><span>LinkedIn</span><span aria-hidden="true">↗</span></a>
              <a href={`mailto:${EMAIL}`} class="social-link"><span>{t.emailLabel}</span><span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </div>

      <footer>
        <span>© 2026 {t.name}</span>
        <span class="footer-motto">{t.footer}</span>
      </footer>
    </main>
  </div>
</Layout>
