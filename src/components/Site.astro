---
// Portfolyo.dc tasarımından uyarlanan arayüz — nokta desenli zemin
// Sol kenar: profil kartı · numaralı menü · ŞU AN kartı · tema & dil
// Sayfalar (sekme): Ana Sayfa · Hakkımda · Projeler · İletişim
import Layout from "../layouts/Layout.astro";
import type { Dict } from "../i18n/translations";
import { SKILLS } from "../i18n/translations";

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const GITHUB = "https://github.com/cebi101";
const LINKEDIN = "https://www.linkedin.com/in/seymanurcebi";
const EMAIL = "seymanurcebi6@gmail.com";

const langs = [
  { code: "TR", href: "/" },
  { code: "EN", href: "/en/" },
  { code: "DE", href: "/de/" },
  { code: "RU", href: "/ru/" },
  { code: "AR", href: "/ar/" },
];

const navItems = [
  { id: "home", num: "01", label: t.nav.home },
  { id: "about", num: "02", label: t.nav.about },
  { id: "projects", num: "03", label: t.nav.projects },
  { id: "contact", num: "04", label: t.nav.contact },
];

const sideSocials = [
  { short: "GH", label: "GitHub", href: GITHUB },
  { short: "IN", label: "LinkedIn", href: LINKEDIN },
  { short: "@", label: t.emailLabel, href: `mailto:${EMAIL}` },
];

const projectHrefs = [GITHUB, GITHUB, GITHUB, GITHUB];
---

<Layout title={t.title} description={t.description} lang={t.lang} dir={t.dir}>
  <div class="app">
    <!-- ════════ KENAR ÇUBUĞU ════════ -->
    <aside class="sidebar">
      <div class="profile-card">
        <div class="avatar-wrap">
          <img src="/foto.jpg" alt={t.hero.photoAlt} class="avatar" />
          <span class="status-dot"></span>
        </div>
        <div class="profile-name">{t.name}</div>
        <div class="profile-role">{t.role}</div>
        <div class="profile-sig">~ {t.signature}</div>
      </div>

      <nav class="nav-links">
        {navItems.map((n) => (
          <a href={`#${n.id}`} class="nav-btn">
            <span class="num">{n.num}</span>
            <span class="lbl">{n.label}</span>
            <span class="arrow">→</span>
          </a>
        ))}
      </nav>

      <div class="side-bottom">
        <div class="now-card">
          <div class="now-head">
            <span class="now-dot"></span>
            <span class="now-label">{t.now.label}</span>
          </div>
          {t.now.items.map((it) => (
            <div class="now-item">
              <span class="now-k">{it.k}</span>
              <span class="now-v">{it.v}</span>
            </div>
          ))}
        </div>

        <div class="social-row">
          {sideSocials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener" : undefined}
              title={s.label}
            >{s.short}</a>
          ))}
        </div>

        <div class="side-label">{t.themeLabel}</div>
        <div class="mode-switch">
          <button data-mode="light" title={t.modeLight}>☀</button>
          <button data-mode="dark" title={t.modeDark}>☾</button>
        </div>

        <div class="side-label">{t.langLabel}</div>
        <div class="lang-switch">
          {langs.map((l) => (
            <a href={l.href} class={t.path === l.href ? "on" : ""}>{l.code}</a>
          ))}
        </div>
      </div>
    </aside>

    <!-- ════════ İÇERİK ════════ -->
    <div class="content">
      <!-- ── 01 ANA SAYFA ── -->
      <div class="tab-panel active" id="home">
        <main class="page home">
          <div class="hero-left">
            <div class="hero-head">
              <div class="hello">{t.hero.hello}</div>
              <h1>
                {t.hero.h1a}<br />
                <em>{t.hero.h1b}</em>
              </h1>
            </div>
            <p class="tagline">{t.hero.tagline}</p>
            <div class="cta-row">
              <a href="#projects" class="btn btn-solid">{t.hero.cta} <span class="arr">→</span></a>
              <a href="#contact" class="btn btn-line">{t.nav.contact}</a>
            </div>
            <div class="stats-row">
              {t.hero.stats.map((s) => (
                <div class="stat">
                  <div
                    class="stat-num"
                    data-count={"count" in s ? s.count : undefined}
                    data-prefix={"prefix" in s ? s.prefix : undefined}
                    data-suffix={"suffix" in s ? s.suffix : undefined}
                  >{s.num}</div>
                  <div class="stat-label">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="hero-photo reveal">
            <div class="photo-backdrop"></div>
            <img src="/foto.jpg" alt={t.hero.photoAlt} class="photo" />
            <div class="photo-badge">{t.role}</div>
          </div>
        </main>
      </div>

      <!-- ── 02 HAKKIMDA ── -->
      <div class="tab-panel" id="about">
        <main class="page">
          <div class="page-head">
            <span class="page-no">{t.about.no}</span>
            <h2 class="section-title">{t.about.title}</h2>
          </div>

          <div class="about-grid">
            <div class="about-photo reveal">
              <img src="/foto.jpg" alt={t.hero.photoAlt} />
              <div class="photo-badge">{t.about.year}</div>
            </div>
            <div class="about-body reveal d1">
              <p class="about-p1">{t.about.p1}</p>
              <p class="about-p2">{t.about.p2}</p>
              <div class="side-label">{t.about.skillsLabel}</div>
              <div class="chips">
                {SKILLS.map((sk) => <span class="chip">{sk}</span>)}
              </div>
            </div>
          </div>

          <div class="side-label block-label reveal">{t.about.journeyLabel}</div>
          <div class="timeline">
            {t.about.journey.map((j, i) => (
              <div class={`tl-item reveal ${i ? `d${Math.min(i, 3)}` : ""}`}>
                <div class="tl-when">{j.when}</div>
                <h3>{j.title}</h3>
                <p>{j.desc}</p>
              </div>
            ))}
          </div>

          <div class="side-label block-label reveal">{t.about.certsLabel}</div>
          <div class="cert-grid">
            {t.about.certs.map((c, i) => (
              <div class={`cert-card reveal ${i ? "d1" : ""}`}>
                <span class="cert-org">{c.org}</span>
                <h3>{c.name}</h3>
                <p>{c.desc}</p>
              </div>
            ))}
          </div>
        </main>
      </div>

      <!-- ── 03 PROJELER ── -->
      <div class="tab-panel" id="projects">
        <main class="page">
          <div class="page-head">
            <span class="page-no">{t.projects.no}</span>
            <h2 class="section-title">{t.projects.title}</h2>
          </div>
          <div class="project-list">
            {t.projects.items.map((p, i) => (
              <a
                href={projectHrefs[i]}
                target="_blank"
                rel="noopener"
                class={`project-row reveal ${i ? `d${Math.min(i, 3)}` : ""}`}
              >
                <span class="pr-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="pr-body">
                  <span class="pr-title">{p.title}</span>
                  <span class="pr-desc">{p.desc}</span>
                  <span class="pr-tags">{p.tags}</span>
                </span>
                <span class="pr-arrow">↗</span>
              </a>
            ))}
          </div>
        </main>
      </div>

      <!-- ── 04 İLETİŞİM ── -->
      <div class="tab-panel" id="contact">
        <main class="page">
          <div class="page-head">
            <span class="page-no">{t.contact.no}</span>
            <h2 class="section-title">{t.contact.title}</h2>
          </div>
          <div class="contact-grid">
            <form class="contact-form reveal" id="contact-form" data-email={EMAIL} data-subject={t.contact.fSubject}>
              <p class="contact-sub">{t.contact.sub}</p>
              <input type="text" name="name" placeholder={t.contact.fName} required />
              <input type="email" name="email" placeholder={t.contact.fEmail} required />
              <textarea name="msg" rows="5" placeholder={t.contact.fMsg} required></textarea>
              <button type="submit" class="btn btn-solid">{t.contact.fSend} <span class="arr">→</span></button>
              <span class="form-hint">{t.contact.fHint}</span>
            </form>
            <div class="contact-side reveal d1">
              <div class="side-label">{t.contact.social}</div>
              <a href={GITHUB} target="_blank" rel="noopener" class="social-link"><span>GitHub</span><span>↗</span></a>
              <a href={LINKEDIN} target="_blank" rel="noopener" class="social-link"><span>LinkedIn</span><span>↗</span></a>
              <a href={`mailto:${EMAIL}`} class="social-link"><span>{t.emailLabel}</span><span>↗</span></a>
            </div>
          </div>
        </main>
      </div>

      <footer>
        <span>© 2026 {t.name}</span>
        <span class="footer-motto">{t.footer}</span>
      </footer>
    </div>
  </div>
</Layout>
