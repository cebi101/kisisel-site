---
// Kalıcı kenar çubuğu — her sayfada aynı; aktif sayfa `current` ile işaretlenir.
import { Image } from "astro:assets";
import type { Dict } from "../i18n/translations";
import { locales } from "../i18n/translations";
import foto from "../assets/foto.jpg";
import { GITHUB, LINKEDIN, EMAIL } from "../data/site";

type PageKey = "home" | "about" | "projects" | "contact";

interface Props {
  t: Dict;
  current: PageKey;
}
const { t, current } = Astro.props;

const navItems: { id: PageKey; num: string; label: string }[] = [
  { id: "home", num: "01", label: t.nav.home },
  { id: "about", num: "02", label: t.nav.about },
  { id: "projects", num: "03", label: t.nav.projects },
  { id: "contact", num: "04", label: t.nav.contact },
];

const sideSocials = [
  { label: "GitHub", href: GITHUB },
  { label: "LinkedIn", href: LINKEDIN },
  { label: t.emailLabel, href: `mailto:${EMAIL}` },
];

// Dil değiştirici aynı sayfanın öbür dildeki karşılığına gider
const langs = [
  { code: "TR", lang: "tr", name: "Türkçe", href: locales.tr.routes[current] },
  { code: "EN", lang: "en", name: "English", href: locales.en.routes[current] },
];
---

<aside class="sidebar">
  <div class="profile-card">
    <div class="avatar-wrap">
      <Image src={foto} width={152} alt={t.hero.photoAlt} class="avatar" loading="eager" />
      <span class="status-dot" aria-hidden="true"></span>
    </div>
    <div class="profile-name">{t.name}</div>
    <div class="profile-role">{t.role}</div>
    <div class="profile-loc">
      <span aria-hidden="true">◍</span> {t.location}
    </div>
    <div class="profile-avail">
      <span class="avail-dot" aria-hidden="true"></span> {t.availability}
    </div>
  </div>

  <nav class="nav-links" aria-label={t.nav.home}>
    {navItems.map((n) => (
      <a
        href={t.routes[n.id]}
        class={`nav-btn ${n.id === current ? "active" : ""}`}
        aria-current={n.id === current ? "page" : undefined}
      >
        <span class="num" aria-hidden="true">{n.num}</span>
        <span class="lbl">{n.label}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>

  <a href={t.routes.cv} class="cv-btn">
    <span>{t.cvLabel}</span>
    <span aria-hidden="true">↓</span>
  </a>

  <div class="side-bottom">
    <div class="now-card">
      <div class="now-head">
        <span class="now-dot" aria-hidden="true"></span>
        <span class="now-label">{t.now.label}</span>
      </div>
      {t.now.items.map((it) => (
        <div class="now-item">
          <span class="now-k">{it.k}</span>
          <span class="now-v">{it.v}</span>
        </div>
      ))}
    </div>

    <div class="social-row">
      {sideSocials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          rel={s.href.startsWith("http") ? "noopener" : undefined}
          title={s.label}
          aria-label={s.label}
        >{s.label}</a>
      ))}
    </div>

    <div class="side-label">{t.themeLabel}</div>
    <div class="mode-switch">
      <button data-mode="light" title={t.modeLight} aria-label={t.modeLight}>☀</button>
      <button data-mode="dark" title={t.modeDark} aria-label={t.modeDark}>☾</button>
    </div>

    <div class="side-label">{t.langLabel}</div>
    <div class="lang-switch">
      {langs.map((l) => (
        <a
          href={l.href}
          hreflang={l.lang}
          lang={l.lang}
          aria-label={l.name}
          aria-current={t.lang === l.lang ? "true" : undefined}
          class={t.lang === l.lang ? "on" : ""}
        >{l.code}</a>
      ))}
    </div>
  </div>
</aside>
