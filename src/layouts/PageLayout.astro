---
// Her içerik sayfasının ortak iskeleti: Layout (head/JS) + kalıcı kenar çubuğu + içerik.
import Layout from "./Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import type { Dict } from "../i18n/translations";
import { GITHUB, LINKEDIN, EMAIL } from "../data/site";
import { PAGES, EXTRA_PAGES, type PageKey, type NavKey } from "../data/routes";

interface Props {
  t: Dict;
  current: NavKey;
  title?: string;
  description?: string;
}
const { t, current, title, description } = Astro.props;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Şeyma Nur Çebi",
  jobTitle: t.title.split("—")[1]?.trim(),
  email: `mailto:${EMAIL}`,
  sameAs: [GITHUB, LINKEDIN],
};
---

<Layout
  title={title ?? t.title}
  description={description ?? t.description}
  lang={t.lang}
  dir={t.dir}
>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
  <a class="skip-link" href="#icerik">{t.skipLink}</a>
  <div class="app">
    <Sidebar t={t} current={current} />

    <main class="content" id="icerik" tabindex="-1" transition:animate="slide">
      <slot />
    </main>

    <footer>
      {
        /*
        Kenar çubuğu gizlenebilir üç yol var (mobil çekmece, masaüstü katlama,
        kenar çubuğu içermeyen iskeletler) ve üçünde de ekranda tıklanabilir
        HİÇBİR bağlantı kalmıyordu. Bu satır durumdan bağımsızdır.
      */
      }
      <nav class="foot-nav" aria-label={t.navLabel}>
        {
          [...PAGES, ...EXTRA_PAGES].map((p) => (
            <a href={t.routes[p.key]} aria-current={p.key === current ? "page" : undefined}>
              {p.key === "cv"
                ? t.cvLabel
                : p.key === "privacy"
                  ? t.privacy.title
                  : t.nav[p.key as PageKey]}
            </a>
          ))
        }
      </nav>
      <span>© 2026 {t.displayName}</span>
      <span class="footer-views" id="site-views" data-label={t.guestbook.viewsLabel} hidden></span>
      <span class="footer-motto">{t.footer}</span>
    </footer>
  </div>
</Layout>
