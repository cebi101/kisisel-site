---
// Tek sayfalık, yazdırılabilir özgeçmiş belgesi — site içeriğinden üretilir.
// Kenar çubuğu/sekme YOK; her zaman açık (kâğıt) tema; A4 print CSS.
import { Image } from "astro:assets";
import type { Dict } from "../i18n/translations";
import { locales } from "../i18n/translations";
import { SKILL_GROUPS } from "../i18n/translations";
import foto from "../assets/foto.jpg";

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const GITHUB = "https://github.com/cebi101";
const LINKEDIN = "https://www.linkedin.com/in/seymanurcebi";
const EMAIL = "seymanurcebi6@gmail.com";

const fullName = `${t.hero.h1a} ${t.hero.h1b}`.replace(/\.$/, "");
const pageTitle = `${t.cvTitle} — ${fullName}`;
const other = t.lang === "tr" ? locales.en : locales.tr;
---

<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sora-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts-cv.css" />
    <style>
      :root {
        --paper: #ffffff;
        --ink: #2b2620;
        --body: #423b32;
        --muted: #6a6054;
        --accent: #a15c50;
        --accent2: #5f6947;
        --line: #e7ded7;
        --chip: #f4ece7;
        --font-display: "Fraunces", Georgia, serif;
        --font-sans: "Sora", -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: "DM Mono", "JetBrains Mono", Menlo, monospace;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #efe7e2;
        color: var(--body);
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }

      /* ---- ekran araç çubuğu (yazdırmada gizli) ---- */
      .bar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        max-width: 820px;
        margin: 0 auto;
        padding: 16px 20px;
      }
      .bar { gap: 12px; }
      .bar a {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--muted);
      }
      .bar a:hover { color: var(--accent); }
      .bar button {
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 14px;
        padding: 11px 22px;
        border: none;
        border-radius: 100px;
        background: var(--accent);
        color: #fff;
        cursor: pointer;
      }
      .bar button:hover { background: #854a3f; }

      /* ---- CV kâğıdı ---- */
      .cv {
        max-width: 820px;
        margin: 0 auto 40px;
        background: var(--paper);
        padding: 48px 52px;
        border-radius: 8px;
        box-shadow: 0 10px 40px -12px rgba(0, 0, 0, 0.25);
      }

      .cv-head {
        display: flex;
        align-items: center;
        gap: 28px;
        border-bottom: 2px solid var(--accent);
        padding-bottom: 18px;
        margin-bottom: 22px;
      }
      .cv-head-text { flex: 1; min-width: 0; }
      .cv-photo {
        flex-shrink: 0;
        width: 104px;
        height: 124px;
        object-fit: cover;
        object-position: center 25%;
        border-radius: 10px;
      }
      .cv-name {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 40px;
        line-height: 1.02;
        letter-spacing: -1px;
        color: var(--ink);
      }
      [dir="rtl"] .cv-name { letter-spacing: 0; }
      .cv-role {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent);
        margin-top: 6px;
      }
      .cv-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        margin-top: 12px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted);
      }
      .cv-contact a:hover { color: var(--accent); }

      section { margin-top: 22px; }
      .sec-title {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent2);
        border-bottom: 1px solid var(--line);
        padding-bottom: 5px;
        margin-bottom: 12px;
      }

      .summary { color: var(--body); }
      .summary p + p { margin-top: 8px; }

      .item { margin-bottom: 13px; }
      .item:last-child { margin-bottom: 0; }
      .item-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
      }
      .item-title { font-weight: 600; font-size: 15px; color: var(--ink); }
      .item-when {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--muted);
        white-space: nowrap;
      }
      .item-desc { font-size: 13.5px; color: var(--body); margin-top: 2px; }
      .item-badge {
        display: inline-block;
        margin-top: 5px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent2);
        border: 1px solid var(--line);
        border-radius: 100px;
        padding: 2px 10px;
      }
      .item-tags {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--accent2);
        margin-top: 3px;
      }

      .skills-row { display: flex; gap: 10px; margin-bottom: 8px; align-items: baseline; }
      .skills-row:last-child { margin-bottom: 0; }
      .skills-label {
        flex: 0 0 auto;
        min-width: 132px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--muted);
      }
      [dir="rtl"] .skills-label { letter-spacing: 0; }
      .skills-items { display: flex; flex-wrap: wrap; gap: 6px; }
      .skill {
        direction: ltr;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--ink);
        background: var(--chip);
        border-radius: 100px;
        padding: 3px 11px;
      }

      /* ---- YAZDIRMA / PDF ---- */
      /* ---- YAZDIRMA / PDF: TEK SAYFAYA SIĞAR ---- */
      @media print {
        @page { size: A4; margin: 9mm 10mm; }
        body { background: #fff; font-size: 8.2pt; line-height: 1.26; }
        .no-print { display: none !important; }
        .cv {
          max-width: none;
          margin: 0;
          padding: 0;
          border-radius: 0;
          box-shadow: none;
        }

        /* başlık */
        .cv-head { gap: 14px; padding-bottom: 6px; margin-bottom: 7px; break-inside: avoid; }
        .cv-name { font-size: 19pt; letter-spacing: -0.5px; }
        .cv-role { font-size: 7.4pt; letter-spacing: 1.4px; margin-top: 2px; }
        .cv-contact { gap: 2px 10px; margin-top: 5px; font-size: 7.6pt; }
        .cv-photo {
          width: 68px; height: 82px; border-radius: 7px;
          -webkit-print-color-adjust: exact; print-color-adjust: exact;
        }

        /* bölümler */
        section { margin-top: 5px; }
        .sec-title { font-size: 7.2pt; letter-spacing: 1.2px; padding-bottom: 2px; margin-bottom: 3px; }
        .summary p + p { margin-top: 2px; }

        .item { margin-bottom: 3px; break-inside: avoid; }
        .item-title { font-size: 8.6pt; }
        .item-when { font-size: 7.4pt; }
        .item-desc { font-size: 7.9pt; margin-top: 0; }
        .item-badge { margin-top: 2px; padding: 1px 7px; font-size: 7.2pt; }
        .item-tags { font-size: 7.4pt; margin-top: 1px; }

        /* projeler ve sertifikalar iki sütunda — yatay alanı kullan */
        .cv-cols { columns: 2; column-gap: 16px; }
        .cv-cols-3 { columns: 3; column-gap: 14px; }
        .cv-cols-3 .item { break-inside: avoid; }
        .cv-cols .item { break-inside: avoid; }

        /* yetenekler tek satıra yakın */
        .skills-row { gap: 6px; margin-bottom: 2px; break-inside: avoid; }
        .skills-label { min-width: 104px; font-size: 7.2pt; letter-spacing: 0.6px; }
        .skills-items { gap: 3px; }
        .skill { font-size: 7.4pt; padding: 1px 7px; }
      }

      @media (max-width: 640px) {
        .cv { padding: 30px 22px; }
        .cv-name { font-size: 30px; }
        .skills-row { flex-direction: column; gap: 4px; }
      }
    </style>
  </head>
  <body>
    <div class="bar no-print">
      <a href={t.routes.home}>{t.cvBack}</a>
      <a href={other.routes.cv} hreflang={other.lang} lang={other.lang} class="cv-lang">{other.lang.toUpperCase()}</a>
      <button id="cv-print">{t.cvSave}</button>
    </div>

    <main class="cv">
      <header class="cv-head">
        <div class="cv-head-text">
          <div class="cv-name">{fullName}</div>
          <div class="cv-role">{t.role}</div>
          <div class="cv-contact">
            <span>◍ {t.location}</span>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            <a href={GITHUB} target="_blank" rel="noopener">github.com/cebi101</a>
            <a href={LINKEDIN} target="_blank" rel="noopener">linkedin.com/in/seymanurcebi</a>
          </div>
        </div>
        <Image src={foto} width={240} alt={t.hero.photoAlt} class="cv-photo" />
      </header>

      <section>
        <div class="sec-title">{t.cvProfile}</div>
        <div class="summary">
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
        </div>
      </section>

      <section>
        <div class="sec-title">{t.about.eduLabel}</div>
        {t.about.edu.map((e) => (
          <div class="item">
            <div class="item-top">
              <span class="item-title">{e.title}</span>
              <span class="item-when">{e.when}</span>
            </div>
            <div class="item-desc">{e.desc}</div>
            <span class="item-badge">{e.badge}</span>
          </div>
        ))}
      </section>

      <section>
        <div class="sec-title">{t.about.expLabel}</div>
        {t.about.exp.map((e) => (
          <div class="item">
            <div class="item-top">
              <span class="item-title">{e.title}</span>
              <span class="item-when">{e.when}</span>
            </div>
            <div class="item-desc">{e.desc}</div>
          </div>
        ))}
      </section>

      <section>
        <div class="sec-title">{t.about.compLabel}</div>
        {t.about.comp.map((e) => (
          <div class="item">
            <div class="item-top">
              <span class="item-title">{e.title}</span>
              <span class="item-when">{e.when}</span>
            </div>
            <div class="item-desc">{e.desc}</div>
          </div>
        ))}
      </section>

      <section>
        <div class="sec-title">{t.projects.title}</div>
        <div class="cv-cols">
        {t.projects.items.map((p) => (
          <div class="item">
            <div class="item-title">{p.title}</div>
            <div class="item-desc">{p.desc}</div>
            <div class="item-tags">{p.tags}</div>
          </div>
        ))}
        </div>
      </section>

      <section>
        <div class="sec-title">{t.about.certsLabel}</div>
        <div class="cv-cols cv-cols-3">
        {t.about.certs.map((c) => (
          <div class="item">
            <div class="item-title">{c.name} · {c.org}</div>
            <div class="item-desc">{c.desc}</div>
          </div>
        ))}
        </div>
      </section>

      <section>
        <div class="sec-title">{t.about.skillsLabel}</div>
        {SKILL_GROUPS.map((g) => (
          <div class="skills-row">
            <span class="skills-label">{t.about.skillGroups[g.key]}</span>
            <span class="skills-items">
              {g.items.map((s) => <span class="skill">{s}</span>)}
            </span>
          </div>
        ))}
      </section>
    </main>

    <script>
      document.getElementById("cv-print")?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>
