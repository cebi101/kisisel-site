---
import { otherLangPath } from "../data/routes";
import { ClientRouter } from "astro:transitions";
import "../styles/fonts.css";
import "../styles/global.css";
import { tr } from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  dir?: string;
}

const { title = tr.title, description = tr.description, lang = "tr", dir = "ltr" } = Astro.props;

const OG_LOCALES: Record<string, string> = {
  tr: "tr_TR",
  en: "en_US",
};
const ogAlternates = Object.entries(OG_LOCALES)
  .filter(([k]) => k !== lang)
  .map(([, v]) => v);

// Mutlak URL'ler — sitemap/canonical/paylaşım kartı için (astro.config > site)
const canonical =
  new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "") || Astro.site!.href;
const ogImage = new URL("/og.png", Astro.site).href;
// TR ↔ EN eşleştirmesi: /hakkimda ↔ /en/about
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const trPath = lang === "tr" ? path : otherLangPath(path, "en");
const enPath = lang === "tr" ? otherLangPath(path, "tr") : path;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6ef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Şeyma Nur Çebi" />
    <meta property="og:locale" content={OG_LOCALES[lang] ?? "tr_TR"} />
    {ogAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href={new URL(trPath, Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(trPath, Astro.site).href} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Tipografi: kendi sunucumuzda barındırılıyor (dış istek yok) -->
    <!-- Kritik renkler: dış CSS inmeden ilk kare bile doğru boyansın (beyaz parlama olmasın) -->
    <style is:inline>
      html {
        background: #f7f6ef;
        color: #3a3d30;
      }
      html[data-mode="dark"] {
        background: #1a1c16;
        color: #dfe1d4;
      }
      body {
        margin: 0;
        background: inherit;
        color: inherit;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
    {
      /*
      Ş, ş, Ğ, ğ, İ harfleri YALNIZCA `ext` alt kümesinde; `latin` içermiyor.
      Sitenin varsayılan dili Türkçe ve LCP öğesi "Şeyma Nur Çebi" — ilk harfi
      ext dosyasını gerektiriyor. Eskiden yalnız latin preload ediliyordu, bu
      yüzden Türkçe karakterlerde yedek fontla çizim (FOUT) ve LCP gecikmesi
      oluyordu. Türkçe sayfalarda ext de preload edilir.
    */
    }
    {
      ["sora-400-normal", "fraunces-900-normal"].map((ad) => (
        <>
          <link
            rel="preload"
            href={`/fonts/${ad}-latin.woff2`}
            as="font"
            type="font/woff2"
            crossorigin
          />
          {lang === "tr" && (
            <link
              rel="preload"
              href={`/fonts/${ad}-ext.woff2`}
              as="font"
              type="font/woff2"
              crossorigin
            />
          )}
        </>
      ))
    }
    <!-- Tema: boyamadan ÖNCE uygula (parlama olmasın) -->
    <script is:inline>
      // Görünüm tercihini <html> üzerine BOYAMADAN ÖNCE uygular.
      //
      // ÖNEMLİ: Sayfa geçişinde (View Transitions) Astro <html> etiketinin
      // özniteliklerini YENİ belgeden kopyalar. data-mode ve sidebar-off
      // çalışma anında yazıldığı için sunucudan gelen belgede yoktur —
      // yani geçişte SİLİNİRLER ve tema kendiliğinden gündüze dönerdi.
      // Bu yüzden aynı işlev `astro:after-swap` olayında (yeni sayfa
      // yerleşti ama HENÜZ BOYANMADI) tekrar çalıştırılır.
      (() => {
        const uygula = () => {
          // localStorage engelliyken (Safari kilitli mod vb.) SecurityError fırlatır
          let saved = null;
          try {
            saved = localStorage.getItem("mode");
          } catch {
            /* depolama engelli olabilir (gizli mod) — sessiz geçmek doğru */
          }
          // varsayılan: gündüz; sistem gece tercihindeyse gece
          const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.mode =
            saved === "light" || saved === "dark" ? saved : system;

          // masaüstünde kenar çubuğu tercihi (katlı/açık)
          let sb = null;
          try {
            sb = localStorage.getItem("sidebar");
          } catch {
            /* depolama engelli olabilir (gizli mod) — sessiz geçmek doğru */
          }
          document.documentElement.classList.toggle("sidebar-off", sb === "off");
          document.documentElement.classList.add("js");
        };
        uygula();
        document.addEventListener("astro:after-swap", uygula);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <slot />

    <script>
      import { EMAIL, GITHUB } from "../data/contact";
      // ---------- Okuma ilerleme çubuğu ----------
      // View Transitions ile gövde değiştiği için öğe her sayfada yeniden aranır
      const setProgress = () => {
        const bar = document.getElementById("scroll-progress");
        if (!bar) return;
        const max = document.documentElement.scrollHeight - innerHeight;
        bar.style.width = max > 0 ? `${Math.min((scrollY / max) * 100, 100)}%` : "0%";
      };
      addEventListener("scroll", setProgress, { passive: true });
      addEventListener("resize", setProgress);

      // ---------- İmleç ışıltısı (ayrı parça) ----------
      // Mobilde hiç kullanılmayan ~2,2 KB'lık kod artık indirilmiyor.
      const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches;
      const lessMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let sparkleReattach: (() => void) | null = null;
      if (finePointer && !lessMotion) {
        import("../scripts/sparkle").then((m) => {
          m.init();
          sparkleReattach = m.reattach;
        });
      }

      // ---------- Gündüz / Gece anahtarı ----------
      const syncMode = () => {
        const mode = document.documentElement.dataset.mode;
        document.querySelectorAll<HTMLButtonElement>(".mode-switch button").forEach((b) => {
          b.classList.toggle("on", b.dataset.mode === mode);
          b.setAttribute("aria-pressed", String(b.dataset.mode === mode));
        });
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        themeMeta?.setAttribute("content", mode === "dark" ? "#1a1c16" : "#f7f6ef");
      };
      const bindTheme = () => {
        document.querySelectorAll<HTMLButtonElement>(".mode-switch button").forEach((b) => {
          if (b.dataset.bound) return;
          b.dataset.bound = "1";
          b.addEventListener("click", () => {
            const m = b.dataset.mode || "dark";
            document.documentElement.dataset.mode = m;
            try {
              localStorage.setItem("mode", m);
            } catch {
              /* depolama engelli olabilir (gizli mod) — sessiz geçmek doğru */
            }
            syncMode();
          });
        });
        syncMode();
      };

      // ---------- Scroll'da görünme ----------
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 },
      );
      const observeReveals = () =>
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

      // ---------- İletişim formu → e-posta uygulaması ----------
      const bindForm = () => {
        const form = document.getElementById("contact-form") as HTMLFormElement | null;
        if (!form || form.dataset.bound) return;
        form.dataset.bound = "1";
        const durumEl = document.getElementById("form-durum");
        const metin = JSON.parse(form.dataset.strings || "{}");
        const yaz = (m: string) => {
          if (!durumEl) return;
          durumEl.textContent = m;
          durumEl.hidden = !m;
        };
        /** Sunucu ucu yoksa/başarısızsa eski davranış: e-posta uygulamasını aç. */
        const mailtoyaDus = (name: string, from: string, msg: string) => {
          const email = form.dataset.email || "";
          const subject = encodeURIComponent(`${form.dataset.subject || ""} — ${name}`);
          const body = encodeURIComponent(`${msg}\n\n— ${name} (${from})`);
          location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        };
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const btn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
          if (btn?.disabled) return;
          const fd = new FormData(form);
          const name = String(fd.get("name") || "").trim();
          const from = String(fd.get("email") || "").trim();
          const msg = String(fd.get("msg") || "").trim();
          if (btn) btn.disabled = true;
          yaz(metin.sending || "");
          try {
            const r = await fetch("/api/contact", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                name,
                email: from,
                message: msg,
                website: String(fd.get("website") || ""),
              }),
            });
            const d = await r.json().catch(() => ({}));
            // DOĞRULAMA hatasını SAĞLAYICI arızasından ayır: eskiden 400 de
            // mailto açıyordu, yani kısa bir mesaj "e-posta uygulaman açılıyor"
            // deyip çöp bir taslak açıyordu.
            if (r.ok && d.ok) {
              yaz(metin.sent || "");
              form.reset();
            } else if (r.status === 429) {
              yaz(metin.rate || "");
            } else if (r.status === 400 || r.status === 422) {
              yaz(metin.invalid || metin.failed || "");
            } else {
              // 503, ağ hatası → mailto yedeği
              yaz(metin.failed || "");
              mailtoyaDus(name, from, msg);
            }
          } catch {
            yaz(metin.failed || "");
            mailtoyaDus(name, from, msg);
          } finally {
            if (btn) btn.disabled = false;
          }
        });
      };

      // ---------- Ziyaretçi sayacı ----------
      // Oturumda yalnızca bir kez artırılır. Sunucu/veritabanı yoksa
      // hiçbir şey görünmez — site normal çalışmaya devam eder.
      const showViews = (n: unknown) => {
        const el = document.getElementById("site-views") as HTMLElement | null;
        if (!el || typeof n !== "number") return;
        const loc = document.documentElement.lang === "en" ? "en-GB" : "tr-TR";
        el.textContent = `${n.toLocaleString(loc)} ${el.dataset.label ?? ""}`.trim();
        el.hidden = false;
      };
      // Modül durumu gezinmeler boyunca yaşar; sessionStorage engelliyse bile
      // sayfa başına tek istek atılır ve sayaç şişmez.
      let visitCounted = false;
      let visitInFlight = false;
      const countVisit = () => {
        if (visitInFlight) return;
        let stored = "";
        try {
          stored = sessionStorage.getItem("visit-counted") ?? "";
        } catch {
          /* depolama engelli olabilir (gizli mod) — sessiz geçmek doğru */
        }
        const alreadyCounted = visitCounted || stored !== "";
        // Bayrağı istekten ÖNCE yaz: yarış durumunda ikinci artış olmasın
        visitCounted = true;
        if (!alreadyCounted) {
          try {
            sessionStorage.setItem("visit-counted", "1");
          } catch {
            /* depolama engelli olabilir (gizli mod) — sessiz geçmek doğru */
          }
        }
        visitInFlight = true;
        fetch("/api/views", { method: alreadyCounted ? "GET" : "POST" })
          .then((r) => r.json())
          .then((d) => showViews(d.views))
          .catch(() => {})
          .finally(() => {
            visitInFlight = false;
          });
      };

      // ---------- Mobil çekmece menü ----------
      /** Çekmeceyi dışarıdan kapatabilmek için tutulur (sayfa geçişi sonrası). */
      let cekmeceKapat: (() => void) | null = null;

      // Escape PENCEREYE bağlanır; pencere gezinmelerde ölmez, bu yüzden
      // bu dinleyici bindDrawer'ın İÇİNDE OLAMAZ. Orada `#menu-toggle`
      // üzerindeki dataset.bound koruması işe yaramaz (öğe her geçişte
      // yenilenir), dolayısıyla her sekme tıklamasında bir dinleyici daha
      // eklenir ve her biri bir önceki sayfanın tüm DOM'unu canlı tutardı.
      addEventListener("keydown", (e) => {
        if (e.key === "Escape") cekmeceKapat?.();
      });

      const bindDrawer = () => {
        const btn = document.getElementById("menu-toggle");
        const sidebar = document.getElementById("sidebar");
        const scrim = document.getElementById("menu-scrim");
        if (!btn || !sidebar || !scrim) return;

        const wide = () => matchMedia("(min-width: 941px)").matches;
        // Kapanış animasyonu bitince scrim gizlenir. Bekleyen bu zamanlayıcı
        // İPTAL EDİLMEZSE, 350 ms dolmadan çekmece yeniden açıldığında
        // scrim açık çekmecenin altında gizlenir → dışarı dokunmak kapatmaz.
        let scrimTimer = 0;
        const setOpen = (open: boolean) => {
          sidebar.classList.toggle("open", open);
          btn.setAttribute("aria-expanded", String(open));
          clearTimeout(scrimTimer);
          if (open) {
            scrim.hidden = false;
            requestAnimationFrame(() => scrim.classList.add("show"));
          } else {
            scrim.classList.remove("show");
            scrimTimer = window.setTimeout(() => {
              scrim.hidden = true;
            }, 350);
          }
        };
        // Kapatma işlevi her yüklemede GÜNCEL öğelere bağlanır.
        // Zaten kapalıysa hiç dokunma: yoksa her gezinmede boş yere
        // 350 ms'lik gizleme zamanlayıcısı kurulurdu.
        cekmeceKapat = () => {
          if (sidebar.classList.contains("open")) setOpen(false);
        };

        if (btn.dataset.bound) return; // dinleyiciler yalnız bir kez
        btn.dataset.bound = "1";

        const syncWide = () => {
          if (!wide()) return;
          const off = document.documentElement.classList.contains("sidebar-off");
          btn.setAttribute("aria-expanded", String(!off));
        };
        syncWide();
        btn.addEventListener("click", () => {
          if (wide()) {
            // masaüstü: kenar çubuğunu katla/aç ve tercihi hatırla
            const off = document.documentElement.classList.toggle("sidebar-off");
            btn.setAttribute("aria-expanded", String(!off));
            try {
              localStorage.setItem("sidebar", off ? "off" : "on");
            } catch {
              /* depolama engelli olabilir (gizli mod) — sessiz geçmek doğru */
            }
          } else {
            setOpen(!sidebar.classList.contains("open"));
          }
        });
        scrim.addEventListener("click", () => setOpen(false));
        // menüden bir sayfa seçilince çekmece kapansın (yalnız dar ekranda)
        sidebar.addEventListener("click", (e) => {
          if (!wide() && (e.target as HTMLElement).closest("a")) setOpen(false);
        });
      };

      // ---------- Sayfa geçişlerinde yeniden bağlama ----------
      // ClientRouter gövdeyi değiştirdiği için her yüklemede yeniden kur
      const onPage = () => {
        bindTheme();
        observeReveals();
        bindForm();
        setProgress();
        countVisit();
        bindDrawer();
        // Sayfa geçişinde Astro kenar çubuğunu koruyabiliyor (işaretleme aynı),
        // bu yüzden `open` sınıfı geçişten sağ çıkıp çekmece açık kalıyordu.
        // Dar ekranda her yüklemede kesin kapat.
        if (!matchMedia("(min-width: 941px)").matches) cekmeceKapat?.();
        // ışıltı canvas'ı gövde değişince kopar → geri tak
        // gezinmeden sonra ışıltı canvas'ı gövdeye geri bağlanır
        sparkleReattach?.();
      };
      // ClientRouter astro:page-load'ı İLK yüklemede de tetikler; doğrudan
      // çağırmak dinleyicileri ve sayaç isteğini ikiye katlardı.
      document.addEventListener("astro:page-load", onPage);

      // ---------- Konsol sürprizi ----------
      console.log(
        document.documentElement.lang === "en"
          ? `%c </> code & curiosity %c\n\nHand-written, line by line — no template.\nAstro + TypeScript + plain CSS · TR/EN\n${GITHUB.replace("https://", "")} · ${EMAIL}\n\n— Şeyma Nur Çebi`
          : `%c </> kod & merak %c\n\nBu siteyi hazır şablonla değil, satır satır kendim yazdım.\nAstro + TypeScript + saf CSS · TR/EN\n${GITHUB.replace("https://", "")} · ${EMAIL}\n\n— Şeyma Nur Çebi`,
        "font-size:14px; font-weight:bold; background:#fefd4d; color:#23261c; padding:6px 12px; border-radius:6px;",
        "font-size:12px; color:#9FA98C;",
      );
    </script>
  </body>
</html>
