---
import "../styles/global.css";
import { tr } from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  dir?: string;
}

const {
  title = tr.title,
  description = tr.description,
  lang = "tr",
  dir = "ltr",
} = Astro.props;

const OG_LOCALES: Record<string, string> = {
  tr: "tr_TR",
  en: "en_US",
};
const ogAlternates = Object.entries(OG_LOCALES)
  .filter(([k]) => k !== lang)
  .map(([, v]) => v);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eae8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Şeyma Nur Çebi" />
    <meta property="og:locale" content={OG_LOCALES[lang] ?? "tr_TR"} />
    {ogAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Tipografi: Fraunces (900 display) + DM Mono + Sora -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Yalnızca kullanılan kesimler: Fraunces 900 (roman+italik), Sora 400/500/600, DM Mono 400 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,900;1,9..144,900&family=DM+Mono&family=Sora:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Tema: boyamadan ÖNCE uygula (parlama olmasın) -->
    <script is:inline>
      document.documentElement.classList.add("js");
      (() => {
        // localStorage engelliyken (Safari kilitli mod vb.) SecurityError fırlatır
        let saved = null;
        try { saved = localStorage.getItem("mode"); } catch {}
        // mockup varsayılanı: gündüz; sistem gece tercihindeyse gece
        const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.mode =
          saved === "light" || saved === "dark" ? saved : system;
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      // ---------- Okuma ilerleme çubuğu ----------
      const bar = document.getElementById("scroll-progress");
      if (bar) {
        const setProgress = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = max > 0 ? `${Math.min((scrollY / max) * 100, 100)}%` : "0%";
        };
        addEventListener("scroll", setProgress, { passive: true });
        addEventListener("resize", setProgress);
        setProgress();
      }

      // ---------- İmleç ışıltısı (simli pembe iz) ----------
      // yalnızca gerçek imleçli cihazlarda ve hareket azaltma kapalıyken
      const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches;
      const lessMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (finePointer && !lessMotion) {
        const cvs = document.createElement("canvas");
        cvs.className = "sparkle-canvas";
        cvs.setAttribute("aria-hidden", "true");
        // kritik stiller doğrudan öğede: stil dosyası değişse de efekt bozulmasın
        cvs.style.cssText =
          "position:fixed;inset:0;z-index:30;pointer-events:none;";
        document.body.appendChild(cvs);
        const ctx = cvs.getContext("2d")!;
        let dpr = 1;
        const resize = () => {
          dpr = Math.min(devicePixelRatio || 1, 2);
          cvs.width = innerWidth * dpr;
          cvs.height = innerHeight * dpr;
          cvs.style.width = innerWidth + "px";
          cvs.style.height = innerHeight + "px";
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        addEventListener("resize", resize);

        const TINTS = ["#e87ba0", "#d96b93", "#f2a0bc", "#c9628a", "#fbd7e4"];
        type P = { x: number; y: number; vx: number; vy: number; life: number; max: number; r: number; c: string; spin: number };
        const parts: P[] = [];
        let raf = 0;
        let lastX = 0, lastY = 0;

        const spawn = (x: number, y: number, n: number) => {
          for (let i = 0; i < n && parts.length < 140; i++) {
            const a = Math.random() * Math.PI * 2;
            const sp = 0.25 + Math.random() * 1.5;
            const max = 480 + Math.random() * 520;
            parts.push({
              x: x + (Math.random() - 0.5) * 10,
              y: y + (Math.random() - 0.5) * 10,
              vx: Math.cos(a) * sp,
              vy: Math.sin(a) * sp - 0.25, // hafifçe yukarı süzülsün
              life: 0,
              max,
              r: 1.5 + Math.random() * 3.2,
              c: TINTS[(Math.random() * TINTS.length) | 0],
              spin: Math.random() * Math.PI,
            });
          }
          if (!raf) raf = requestAnimationFrame(tick);
        };

        let prev = 0;
        const tick = (now: number) => {
          const dt = prev ? Math.min(now - prev, 48) : 16;
          prev = now;
          ctx.clearRect(0, 0, innerWidth, innerHeight);
          for (let i = parts.length - 1; i >= 0; i--) {
            const p = parts[i];
            p.life += dt;
            if (p.life >= p.max) { parts.splice(i, 1); continue; }
            const k = p.life / p.max;
            p.x += p.vx * (dt / 16);
            p.y += p.vy * (dt / 16);
            p.vy += 0.006 * (dt / 16); // yumuşak yerçekimi
            p.vx *= 0.99;
            const alpha = k < 0.15 ? k / 0.15 : 1 - (k - 0.15) / 0.85; // belir → sön
            const size = p.r * (1 - k * 0.45);
            ctx.globalAlpha = Math.max(alpha, 0);
            ctx.fillStyle = p.c;
            ctx.shadowColor = p.c;
            ctx.shadowBlur = size * 4; // simli parıltı
            // dört uçlu pırıltı: iki ince çapraz çubuk
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.spin + k * 1.2);
            ctx.fillRect(-size * 2.2, -size * 0.28, size * 4.4, size * 0.56);
            ctx.fillRect(-size * 0.28, -size * 2.2, size * 0.56, size * 4.4);
            ctx.restore();
            // çekirdek nokta
            ctx.beginPath();
            ctx.arc(p.x, p.y, size * 0.55, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          ctx.shadowBlur = 0;
          if (parts.length) {
            raf = requestAnimationFrame(tick);
          } else {
            raf = 0; prev = 0;
            ctx.clearRect(0, 0, innerWidth, innerHeight);
          }
        };

        addEventListener("pointermove", (e) => {
          if (e.pointerType && e.pointerType !== "mouse") return;
          const d = Math.hypot(e.clientX - lastX, e.clientY - lastY);
          lastX = e.clientX; lastY = e.clientY;
          // hız arttıkça biraz daha çok parçacık, ama üst sınırlı
          spawn(e.clientX, e.clientY, d > 40 ? 3 : d > 8 ? 2 : 1);
        }, { passive: true });

        // sekme arkaplana geçince biriktirme
        addEventListener("blur", () => { parts.length = 0; });
      }

      // ---------- Gündüz / Gece anahtarı ----------
      const modeBtns = [...document.querySelectorAll<HTMLButtonElement>(".mode-switch button")];
      const syncMode = () => {
        const mode = document.documentElement.dataset.mode;
        modeBtns.forEach((b) => {
          b.classList.toggle("on", b.dataset.mode === mode);
          b.setAttribute("aria-pressed", String(b.dataset.mode === mode));
        });
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        themeMeta?.setAttribute("content", mode === "dark" ? "#211a19" : "#f1eae8");
      };
      modeBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const m = b.dataset.mode || "dark";
          document.documentElement.dataset.mode = m;
          try { localStorage.setItem("mode", m); } catch {}
          syncMode();
        })
      );
      syncMode();

      // ---------- Scroll'da görünme ----------
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

      // ---------- İletişim formu → e-posta uygulaması ----------
      const form = document.getElementById("contact-form") as HTMLFormElement | null;
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = form.dataset.email || "";
        const name = String(fd.get("name") || "").trim();
        const from = String(fd.get("email") || "").trim();
        const msg = String(fd.get("msg") || "").trim();
        const subject = encodeURIComponent(`${form.dataset.subject || ""} — ${name}`);
        const body = encodeURIComponent(`${msg}\n\n— ${name} (${from})`);
        location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      });

      // ---------- Konsol sürprizi ----------
      console.log(
        document.documentElement.lang === "en"
          ? "%c </> code & curiosity %c\n\nHand-written, line by line — no template.\nAstro + TypeScript + plain CSS · TR/EN\ngithub.com/cebi101 · seymanurcebi6@gmail.com\n\n— Şeyma Nur Çebi"
          : "%c </> kod & merak %c\n\nBu siteyi hazır şablonla değil, satır satır kendim yazdım.\nAstro + TypeScript + saf CSS · TR/EN\ngithub.com/cebi101 · seymanurcebi6@gmail.com\n\n— Şeyma Nur Çebi",
        "font-size:14px; font-weight:bold; background:#B98A82; color:#FBF7F1; padding:6px 12px; border-radius:6px;",
        "font-size:12px; color:#9FA98C;"
      );
    </script>
  </body>
</html>
