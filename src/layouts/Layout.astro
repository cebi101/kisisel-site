---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  dir?: string;
}

const {
  title = "Şeyma Nur Çebi — Yazılım Mühendisliği Öğrencisi",
  description = "Yapay zekâ, prompt engineering ve dil ajanları meraklısı Yazılım Mühendisliği öğrencisi.",
  lang = "tr",
  dir = "ltr",
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eae8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💻</text></svg>" />
    <!-- Tipografi: Fraunces (900 display) + DM Mono + Sora -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=DM+Mono:wght@400;500&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Tema: boyamadan ÖNCE uygula (parlama olmasın) -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("mode");
        // mockup varsayılanı: gündüz; sistem gece tercihindeyse gece
        const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.mode =
          saved === "light" || saved === "dark" ? saved : system;
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      // ---------- Sekme sistemi ----------
      const panels = [...document.querySelectorAll<HTMLElement>(".tab-panel")];
      const navBtns = [...document.querySelectorAll<HTMLAnchorElement>(".nav-btn")];
      const showTab = (id: string) => {
        const target = panels.find((p) => p.id === id) ?? panels[0];
        panels.forEach((p) => p.classList.toggle("active", p === target));
        navBtns.forEach((a) =>
          a.classList.toggle("active", a.hash === `#${target.id}`)
        );
        scrollTo({ top: 0, behavior: "auto" });
      };
      document.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest?.("a[href^='#']") as HTMLAnchorElement | null;
        if (!a) return;
        const id = a.hash.slice(1);
        if (!panels.some((p) => p.id === id)) return;
        e.preventDefault();
        history.pushState(null, "", `#${id}`);
        showTab(id);
      });
      addEventListener("popstate", () => showTab(location.hash.slice(1) || "home"));
      showTab(location.hash.slice(1) || "home");

      // ---------- Gündüz / Gece anahtarı ----------
      const modeBtns = [...document.querySelectorAll<HTMLButtonElement>(".mode-switch button")];
      const syncMode = () => {
        const mode = document.documentElement.dataset.mode;
        modeBtns.forEach((b) => b.classList.toggle("on", b.dataset.mode === mode));
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        themeMeta?.setAttribute("content", mode === "dark" ? "#211a19" : "#f1eae8");
      };
      modeBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const m = b.dataset.mode || "dark";
          document.documentElement.dataset.mode = m;
          localStorage.setItem("mode", m);
          syncMode();
        })
      );
      syncMode();

      // ---------- Scroll'da görünme ----------
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

      // ---------- Sayaç animasyonu ----------
      const counters = document.querySelectorAll<HTMLElement>("[data-count]");
      const countSpy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            countSpy.unobserve(el);
            const target = parseInt(el.dataset.count || "0", 10);
            const suffix = el.dataset.suffix || "";
            const prefix = el.dataset.prefix || "";
            const t0 = performance.now();
            const dur = 1200;
            const tick = (t: number) => {
              const p = Math.min((t - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = `${prefix}${Math.round(target * eased)}${suffix}`;
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.6 }
      );
      counters.forEach((el) => countSpy.observe(el));

      // ---------- İletişim formu → e-posta uygulaması ----------
      const form = document.getElementById("contact-form") as HTMLFormElement | null;
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = form.dataset.email || "";
        const subject = encodeURIComponent(`${form.dataset.subject || ""} — ${fd.get("name") || ""}`);
        const body = encodeURIComponent(
          `${fd.get("msg") || ""}\n\n— ${fd.get("name") || ""} (${fd.get("email") || ""})`
        );
        location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      });

      // ---------- Konsol sürprizi ----------
      console.log(
        "%c </> kod & merak %c\n\nBu siteyi hazır şablonla değil, satır satır kendim yazdım.\nAstro + TypeScript + saf CSS · TR/EN/DE/RU/AR\ngithub.com/cebi101 · seymanurcebi6@gmail.com\n\n— Şeyma Nur Çebi",
        "font-size:14px; font-weight:bold; background:#B98A82; color:#FBF7F1; padding:6px 12px; border-radius:6px;",
        "font-size:12px; color:#9FA98C;"
      );
    </script>
  </body>
</html>
